extends layout

block content
    h1= article.title
    h4 Written by #{author}
    p= article.body
    if user
        if user == article.author
            hr
            a.btn.btn-secondary(href='/articles/edit/'+article._id) Edit
            a.btn.btn-danger.article-delete(href='#', id='article-delete', data-id=article._id) Delete